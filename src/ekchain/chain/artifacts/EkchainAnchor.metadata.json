    "devdoc": {
      "details": "Stores case audit log chain heads on-chain for tamper detection. Each case can have multiple anchors appended over time.",
      "kind": "dev",
      "methods": {
        "anchor(bytes32,bytes32,uint32,string)": {
          "params": {
            "caseId": "The 32-byte case identifier (sha256 of case id string)",
            "chainHead": "The 32-byte hash chain head (sha256 of last entry)",
            "entryCount": "Number of entries in the chain",
            "reportCid": "Optional IPFS CID of the full report"
          }
        },
        "anchorCount(bytes32)": {
          "params": {
            "caseId": "The 32-byte case identifier"
          },
          "returns": {
            "_0": "Number of anchors stored for this case"
          }
        },
        "getAnchors(bytes32)": {
          "params": {
            "caseId": "The 32-byte case identifier"
          },
          "returns": {
            "_0": "Array of AnchorRecord for the case"
          }
        },
        "getLatestAnchor(bytes32)": {
          "params": {
            "caseId": "The 32-byte case identifier"
          },
          "returns": {
            "_0": "The most recent AnchorRecord, or empty if none"
          }
        }
      },
      "title": "EkchainAnchor",
      "version": 1
    },
